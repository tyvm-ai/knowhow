{
  "name": "@tyvm/knowhow-module-voice-control",
  "version": "0.0.1",
  "description": "Interactive voice-agent transport and terminal prototype for Knowhow",
  "main": "ts_build/index.js",
  "types": "ts_build/index.d.ts",
  "scripts": {
    "build": "npm run compile",
    "compile": "npm run clean && tsc && npm run copy-assets",
    "copy-assets": "mkdir -p ts_build/static ts_build/python && cp src/static/* ts_build/static/ && cp python/* ts_build/python/",
    "clean": "rm -rf ts_build",
    "test": "jest --runInBand",
    "prepublishOnly": "npm run compile"
  },
  "keywords": [
    "knowhow",
    "voice",
    "accessibility",
    "agent"
  ],
  "author": "Tyvm AI",
  "license": "MIT",
  "peerDependencies": {
    "@tyvm/knowhow": "*",
    "@tyvm/knowhow-module-computer-use": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "jest": "^29.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21"
  },
  "peerDependenciesMeta": {
    "@tyvm/knowhow-module-computer-use": {
      "optional": true
    }
  }
}
