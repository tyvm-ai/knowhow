{
  "name": "@tyvm/knowhow-computer-core",
  "version": "0.0.1",
  "description": "Knowhow-owned cross-platform computer-use engine (mouse/keyboard/screen) built with napi-rs. Primary driver for @tyvm/knowhow-module-computer-use.",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "knowhow-computer-core",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "keywords": ["knowhow", "computer-use", "automation", "napi", "rust"],
  "author": "Tyvm AI",
  "license": "MIT",
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node ./test/smoke.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "files": ["index.js", "index.d.ts", "*.node"]
}
