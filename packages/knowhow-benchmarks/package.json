{
  "name": "@tyvm/knowhow-benchmarks",
  "version": "0.0.1",
  "description": "Benchmarking framework and leaderboard for Knowhow terminal agent",
  "private": true,
  "scripts": {
    "dev:leaderboard": "cd leaderboard && npm run dev",
    "build:leaderboard": "cd leaderboard && npm run build",
    "build:benchmarks": "cd benchmarks && npm run build",
    "build": "npm run build:benchmarks && npm run build:leaderboard",
    "bench": "cd benchmarks && npm run dev",
    "test": "cd benchmarks && npm test",
    "computer:mouse-precision": "ts-node exercises/computer-use/runner.ts --exercise mouse-precision",
    "computer:compare": "ts-node exercises/computer-use/compare.ts",
    "computer:server": "node exercises/computer-use/mouse-precision/server.js",
    "computer:run": "ts-node exercises/computer-use/runner.ts",
    "computer:form-master": "ts-node exercises/computer-use/runner.ts --exercise form-master",
    "computer:form-server": "node exercises/computer-use/form-master/server.js",
    "computer:fruit-ninja": "ts-node exercises/computer-use/runner.ts --exercise fruit-ninja",
    "computer:fruit-server": "node exercises/computer-use/fruit-ninja/server.js"
  },
  "author": "Micah Riggan",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "commander": "^9.5.0",
    "ora": "^5.4.1"
  }
}
