{
  "name": "@tyvm/knowhow-module-tracing",
  "version": "0.1.0",
  "description": "OpenTelemetry tracing module for @tyvm/knowhow — sends CLI agent traces to Grafana Tempo",
  "main": "ts_build/index.js",
  "types": "ts_build/index.d.ts",
  "scripts": {
    "build": "npm run compile",
    "compile": "npm run clean && tsc",
    "clean": "rm -rf ts_build",
    "prepublishOnly": "npm run compile"
  },
  "keywords": [
    "knowhow",
    "tracing",
    "opentelemetry",
    "grafana",
    "tempo"
  ],
  "author": "Tyvm AI",
  "license": "MIT",
  "peerDependencies": {
    "@tyvm/knowhow": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
