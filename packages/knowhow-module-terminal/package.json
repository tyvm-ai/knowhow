{
  "name": "@tyvm/knowhow-module-terminal",
  "version": "0.0.12",
  "description": "Terminal addon module for @tyvm/knowhow — portless PTY over the tunnel WebSocket",
  "main": "ts_build/index.js",
  "types": "ts_build/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/fix-spawn-helper-permissions.js",
    "build": "npm run compile",
    "compile": "npm run clean && tsc",
    "clean": "node -e \"require('fs').rmSync('ts_build', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run compile",
    "version:nightly": "bash ../knowhow/scripts/publish.sh version:nightly",
    "version:dev": "bash ../knowhow/scripts/publish.sh version:dev",
    "publish:nightly": "bash ../knowhow/scripts/publish.sh nightly",
    "publish:dev": "bash ../knowhow/scripts/publish.sh dev",
    "publish:latest": "bash ../knowhow/scripts/publish.sh stable",
    "publish:stable": "bash ../knowhow/scripts/publish.sh stable"
  },
  "keywords": [
    "knowhow",
    "terminal",
    "pty",
    "tunnel"
  ],
  "author": "Tyvm AI",
  "license": "MIT",
  "peerDependencies": {
    "@tyvm/knowhow": "*"
  },
  "dependencies": {
    "@tyvm/knowhow-tunnel": "*",
    "node-pty": "^1.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.0.0"
  }
}
