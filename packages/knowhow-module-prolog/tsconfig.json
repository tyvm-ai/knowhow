{
  "compilerOptions": {
    "lib": ["es2021", "es2022"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "declaration": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "target": "es2021",
    "outDir": "ts_build",
    "sourceMap": true,
    "strict": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "ts_build"]
}
